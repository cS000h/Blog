---
import Base from '../../layouts/Base.astro';
import Stream from '../../components/Stream.astro';
import SectionTabs from '../../components/SectionTabs.astro';
import { SECTIONS } from '../../config';
import { getAll } from '../../lib/posts';

export function getStaticPaths() {
  return SECTIONS.map((s) => ({ params: { id: s.id }, props: { section: s } }));
}
const { section } = Astro.props;
const all = await getAll();
const counts: Record<string, number> = {};
for (const p of all) if (p.section) counts[p.section] = (counts[p.section] ?? 0) + 1;
const posts = all.filter((p) => p.section === section.id);
---

<Base title={section.name} description={section.intro}>
  <header class="head">
    <p class="mono label">栏目</p>
    <h1>{section.name}</h1>
    <p class="intro">{section.intro}</p>
  </header>
  <SectionTabs current={section.id} counts={counts} total={all.length} />
  <Stream posts={posts} showSection={false} />
</Base>

<style>
  .head { margin: 1rem 0 1.8rem; }
  .head h1 { font-family: var(--font-serif); font-size: 2rem; margin: 0.2rem 0 0.3rem; }
  .intro { margin: 0; color: var(--muted); }
</style>

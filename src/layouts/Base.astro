---
import '../styles/global.css';
import { SITE } from '../config';
import { url } from '../lib/posts';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = SITE.description } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const path = Astro.url.pathname;

const nav = [
  { key: 'H', label: '首页', href: url('/') },
  { key: 'N', label: '笔记', href: url('/notes/') },
  { key: 'A', label: '文章', href: url('/articles/') },
  { key: 'B', label: '关于', href: url('/about/') },
];
const isActive = (href: string) => (href === url('/') ? path === href : path.startsWith(href));
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f5ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1a18" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={url('/rss.xml')} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <header class="site-header wrap">
      <a class="brand" href={url('/')}>
        <span class="brand-mark" aria-hidden="true">~/</span>{SITE.title}<span class="cursor" aria-hidden="true">_</span>
      </a>
      <nav aria-label="主导航">
        {
          nav.map((item) => (
            <a href={item.href} data-key={item.key} aria-current={isActive(item.href) ? 'page' : undefined}>
              <span class="key">[{item.key}]</span>
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer wrap mono">
      <span>© {new Date().getFullYear()} {SITE.author}</span>
      <span>·</span>
      <a href={url('/rss.xml')}>RSS</a>
      <span>·</span>
      <span>用 Markdown 写成</span>
      <span class="hint">按 [H] [N] [A] [B] 快速跳转</span>
    </footer>

    <script is:inline>
      // 键盘快捷键：按导航里方括号中的字母跳转
      document.addEventListener('keydown', (e) => {
        if (e.metaKey || e.ctrlKey || e.altKey) return;
        const t = e.target;
        if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
        const link = document.querySelector(`nav a[data-key="${e.key.toUpperCase()}"]`);
        if (link) location.href = link.getAttribute('href');
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem 1.5rem;
    padding-top: 2.2rem;
    padding-bottom: 2.2rem;
  }
  .brand {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    letter-spacing: 0.02em;
  }
  .brand-mark { color: var(--accent); }
  .cursor { color: var(--accent); animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .cursor { animation: none; } }

  nav { display: flex; flex-wrap: wrap; gap: 0.2rem 1.1rem; }
  nav a {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    text-decoration: none;
    color: var(--muted);
  }
  nav a .key { color: var(--fg); opacity: 0.45; margin-right: 0.15em; }
  nav a:hover, nav a[aria-current='page'] { color: var(--fg); }
  nav a[aria-current='page'] .key { color: var(--accent); opacity: 1; }

  .site-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.6rem;
    margin-top: 5rem;
    padding-top: 1.4rem;
    padding-bottom: 3rem;
    border-top: 1px solid var(--line);
  }
  .site-footer .hint { margin-left: auto; opacity: 0.7; }
  @media (max-width: 560px) {
    .site-footer .hint { display: none; }
  }
</style>

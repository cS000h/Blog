---
// 栏目筛选标签：[全部] [课程学习] [游戏开发] …
import { SECTIONS } from '../config';
import { url } from '../lib/posts';

interface Props {
  current?: string;
  counts: Record<string, number>;
  total: number;
}
const { current, counts, total } = Astro.props;
---

<nav class="tabs mono" aria-label="栏目">
  <a href={url('/')} aria-current={!current ? 'page' : undefined}>全部<sup>{total}</sup></a>
  {
    SECTIONS.map((s) => (
      <a href={url(`/sections/${s.id}/`)} aria-current={current === s.id ? 'page' : undefined}>
        {s.name}
        <sup>{counts[s.id] ?? 0}</sup>
      </a>
    ))
  }
</nav>

<style>
  .tabs { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0 0 2rem; }
  .tabs a {
    text-decoration: none;
    padding: 0.35em 0.75em;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
  }
  .tabs a:hover { color: var(--fg); border-color: var(--muted); }
  .tabs a[aria-current='page'] { background: var(--fg); color: var(--bg); border-color: var(--fg); }
  .tabs sup { font-size: 0.7em; margin-left: 0.3em; opacity: 0.7; }
</style>
